<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Teleauto.UI" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF080808</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textViewStyle">@style/Widget.TeleautoRC.Text</item>
    </style>

    <style name="Widget.TeleautoRC.Text" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="Widget.TeleautoRC.EmptyIcon" parent="@android:style/Widget">
        <item name="android:tint">#FFFFFFFF</item>
        <item name="android:alpha">0.72</item>
    </style>

    <style name="Widget.TeleautoRC.EmptyTitle" parent="Widget.TeleautoRC.Text">
        <item name="android:textColor">#FFF3F3F3</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.TeleautoRC.EmptyDescription" parent="Widget.TeleautoRC.Text">
        <item name="android:textColor">#FF969696</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="Widget.TeleautoRC.Button" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/djirc_ui_bg_button_glass</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@animator/djirc_ui_press_scale</item>
    </style>

    <style name="Widget.TeleautoRC.Button.Danger" parent="Widget.TeleautoRC.Button">
        <item name="android:background">@drawable/djirc_ui_bg_button_danger</item>
    </style>

    <style name="Widget.TeleautoRC.Status" parent="Widget.TeleautoRC.Text">
        <item name="android:background">@drawable/djirc_ui_bg_status_neutral</item>
        <item name="android:textColor">#FFD0D0D0</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="Widget.TeleautoRC.Overlay.Lock" parent="@android:style/Widget">
        <item name="android:background">#B3000000</item>
    </style>

    <style name="Widget.TeleautoRC.Overlay.Video" parent="@android:style/Widget">
        <item name="android:background">#FF000000</item>
    </style>

    <style name="Widget.TeleautoRC.Overlay.Hid" parent="@android:style/Widget">
        <item name="android:background">#F2080808</item>
    </style>

    <style name="Widget.TeleautoRC.ErrorBanner" parent="Widget.TeleautoRC.Text">
        <item name="android:background">#FF242424</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
